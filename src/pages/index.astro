---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";

const featuredCases = (await getCollection("cases", ({ data }) => data.status === "published" && data.featured))
    .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Olá</div>
    <div class="text-5xl font-bold">Sou Patrick Amaral</div>
    <div class="text-2xl py-3 font-bold">Product Designer sênior, Uberlândia, MG</div>
    <div class="py-2">
      <text class="text-lg">
        17 anos de design digital. Nos últimos 5 anos, fui o único designer de produto de
        uma equipe de engenharia no PagBank, respondendo por toda a camada de design das
        iniciativas de marketing e aquisição, da estruturação da experiência ao handoff.
        Prototipação avançada em Figma, fluência em front-end (HTML, CSS e JavaScript) e
        um olhar de composição que vem de 8 anos em direção de arte.
      </text>
    </div>
    <div class="mt-6">
      <a class="btn btn-primary" href="/cv-patrick-amaral.pdf" target="_blank">Baixar CV</a>
      <a class="btn btn-outline ml-3" href="https://wa.me/5534996300677" target="_blank">Falar comigo</a>
      <a class="btn btn-outline ml-3" href="https://www.linkedin.com/in/pamaralbr" target="_blank">LinkedIn</a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">Trabalhos em destaque</div>
  </div>

  {
    featuredCases.length === 0 ? (
      <div class="bg-base-200 border-l-4 border-secondary w-full p-4 min-w-full">
        <p>Nenhum case em destaque ainda. Veja todos em <a class="link" href="/trabalhos/">/trabalhos</a>.</p>
      </div>
    ) : (
      featuredCases.map((entry) => (
        <>
          <HorizontalCard
            title={entry.data.title}
            img={entry.data.thumbnail}
            desc={entry.data.subtitle}
            url={"/trabalhos/" + entry.id}
            target="_self"
            badge={entry.data.confidential ? "Confidencial" : undefined}
            tags={entry.data.disciplines}
          />
          <div class="divider my-0" />
        </>
      ))
    )
  }
</BaseLayout>
