---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";

const featuredCases = (await getCollection("cases", ({ data }) => data.status === "published" && data.featured))
    .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-14 mt-5 flex flex-col gap-4">
    <div class="font-mono text-sm uppercase tracking-wide text-accent">Olá</div>
    <h1 class="font-display text-5xl font-bold leading-tight">Sou Patrick Amaral</h1>
    <div class="text-xl font-medium text-muted">Product Designer sênior, Uberlândia, MG</div>
    <p class="text-base leading-relaxed max-w-[640px]">
      17 anos de design digital. Nos últimos 5 anos, fui o único designer de produto de
      uma equipe de engenharia no PagBank, respondendo por toda a camada de design das
      iniciativas de marketing e aquisição, da estruturação da experiência ao handoff.
      Prototipação avançada em Figma, fluência em front-end (HTML, CSS e JavaScript) e
      um olhar de composição que vem de 8 anos em direção de arte.
    </p>
    <div class="mt-2 flex flex-wrap gap-3">
      <a class="btn btn-primary" href="/cv-patrick-amaral.pdf" target="_blank">Baixar CV</a>
      <a class="btn btn-outline" href="https://wa.me/5534996300677" target="_blank">Falar comigo</a>
      <a class="btn btn-outline" href="https://www.linkedin.com/in/pamaralbr" target="_blank">LinkedIn</a>
    </div>
  </div>

  <div>
    <h2 class="font-display text-2xl font-semibold mb-4">Trabalhos em destaque</h2>
  </div>

  {
    featuredCases.length === 0 ? (
      <div class="rounded-xl border border-line bg-surface p-4">
        <p>Nenhum case em destaque ainda. Veja todos em <a href="/trabalhos/">/trabalhos</a>.</p>
      </div>
    ) : (
      <div class="flex flex-col gap-4">
        {featuredCases.map((entry) => (
          <HorizontalCard
            title={entry.data.title}
            img={entry.data.thumbnail}
            desc={entry.data.subtitle}
            url={"/trabalhos/" + entry.id}
            target="_self"
            badge={entry.data.confidential ? "Confidencial" : undefined}
            tags={entry.data.disciplines}
          />
        ))}
      </div>
    )
  }
</BaseLayout>
