---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const isListed = ({ data }: { data: { status: string; private: boolean } }) =>
    data.status === "published" && !data.private;

const cases = (await getCollection("cases", isListed)).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection("projects", isListed)).sort((a, b) => a.data.order - b.data.order);

const disciplinesInUse = Array.from(
    new Set(cases.flatMap((entry) => entry.data.disciplines))
).sort();
---

<BaseLayout title="Trabalhos" sideBarActiveItemID="trabalhos">
    <div class="mb-5">
        <h1 class="text-3xl w-full font-bold">Trabalhos</h1>
    </div>

    <h2 class="font-display text-xl font-semibold mb-4">Cases</h2>

    {
        cases.length === 0 ? (
            <div class="rounded-xl border border-line bg-surface p-4">
                <p class="font-semibold">Ainda não há cases publicados.</p>
                <p class="text-muted">Volte em breve.</p>
            </div>
        ) : (
            <>
                {
                    disciplinesInUse.length > 1 && (
                        <div class="flex flex-wrap gap-2 mb-6" id="discipline-filter">
                            <button type="button" class="tag tag-accent" data-discipline="all">
                                Todos
                            </button>
                            {disciplinesInUse.map((discipline) => (
                                <button type="button" class="tag" data-discipline={discipline}>
                                    {discipline}
                                </button>
                            ))}
                        </div>
                    )
                }

                <ul class="flex flex-col gap-4" id="case-list">
                    {cases.map((entry) => (
                        <li data-disciplines={entry.data.disciplines.join(",")}>
                            <HorizontalCard
                                title={entry.data.title}
                                img={entry.data.thumbnail}
                                desc={entry.data.subtitle}
                                url={"/trabalhos/" + entry.id}
                                target="_self"
                                badge={entry.data.confidential ? "Confidencial" : undefined}
                                tags={entry.data.disciplines}
                            />
                        </li>
                    ))}
                </ul>
            </>
        )
    }

    {
        projects.length > 0 && (
            <section class="mt-12" aria-labelledby="outros-projetos">
                <h2 id="outros-projetos" class="font-display text-xl font-semibold mb-1">Outros projetos</h2>
                <p class="text-sm text-muted mb-4">Entregas de UI em produção, com layout desktop e mobile.</p>
                <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    {projects.map((entry) => (
                        <li>
                            <ProjectCard
                                title={entry.data.title}
                                img={entry.data.thumbnail}
                                imgAlt={entry.data.thumbnailAlt}
                                url={"/trabalhos/" + entry.id}
                                tags={[entry.data.company, entry.data.type].filter((tag): tag is string => !!tag)}
                            />
                        </li>
                    ))}
                </ul>
            </section>
        )
    }
</BaseLayout>

<script>
    const filterBar = document.getElementById("discipline-filter");
    const items = document.querySelectorAll("#case-list > li");

    filterBar?.addEventListener("click", (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-discipline]");
        if (!button) return;

        filterBar.querySelectorAll("button").forEach((b) => b.classList.remove("tag-accent"));
        button.classList.add("tag-accent");

        const selected = button.dataset.discipline;
        items.forEach((item) => {
            const disciplines = (item as HTMLElement).dataset.disciplines?.split(",") ?? [];
            const show = selected === "all" || disciplines.includes(selected ?? "");
            (item as HTMLElement).classList.toggle("hidden", !show);
        });
    });
</script>
