---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
import { getCollection } from "astro:content";

const allCases = await getCollection("cases");
const cases = allCases
    .filter((entry) => entry.data.status === "published" && !entry.data.private)
    .sort((a, b) => a.data.order - b.data.order);

const disciplinesInUse = Array.from(
    new Set(cases.flatMap((entry) => entry.data.disciplines))
).sort();
---

<BaseLayout title="Trabalhos" sideBarActiveItemID="trabalhos">
    <div class="mb-5">
        <div class="text-3xl w-full font-bold">Trabalhos</div>
    </div>

    {
        cases.length === 0 ? (
            <div class="bg-base-200 border-l-4 border-secondary w-full p-4 min-w-full">
                <p class="font-bold">Ainda não há cases publicados.</p>
                <p>Volte em breve.</p>
            </div>
        ) : (
            <>
                {
                    disciplinesInUse.length > 1 && (
                        <div class="flex flex-wrap gap-2 mb-6" id="discipline-filter">
                            <button type="button" class="btn btn-sm btn-active" data-discipline="all">
                                Todos
                            </button>
                            {disciplinesInUse.map((discipline) => (
                                <button type="button" class="btn btn-sm btn-outline" data-discipline={discipline}>
                                    {discipline}
                                </button>
                            ))}
                        </div>
                    )
                }

                <ul id="case-list">
                    {cases.map((entry) => (
                        <li data-disciplines={entry.data.disciplines.join(",")}>
                            <HorizontalCard
                                title={entry.data.title}
                                img={entry.data.thumbnail}
                                desc={entry.data.subtitle}
                                url={"/trabalhos/" + entry.id}
                                target="_self"
                                badge={entry.data.confidential ? "Confidencial" : undefined}
                                tags={entry.data.disciplines}
                            />
                            <div class="divider my-0" />
                        </li>
                    ))}
                </ul>
            </>
        )
    }
</BaseLayout>

<script>
    const filterBar = document.getElementById("discipline-filter");
    const items = document.querySelectorAll("#case-list > li");

    filterBar?.addEventListener("click", (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-discipline]");
        if (!button) return;

        filterBar.querySelectorAll("button").forEach((b) => b.classList.remove("btn-active"));
        button.classList.add("btn-active");

        const selected = button.dataset.discipline;
        items.forEach((item) => {
            const disciplines = (item as HTMLElement).dataset.disciplines?.split(",") ?? [];
            const show = selected === "all" || disciplines.includes(selected ?? "");
            (item as HTMLElement).classList.toggle("hidden", !show);
        });
    });
</script>
