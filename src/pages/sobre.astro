---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Sobre" sideBarActiveItemID="sobre">
    <div class="mb-5">
        <div class="text-3xl w-full font-bold">Sobre</div>
    </div>

    <div class="bg-base-200 border-l-4 border-secondary w-full p-4 mb-8">
        <p class="font-bold">Placeholder</p>
        <p>Texto real de trajetória, forma de trabalhar e ferramentas entra numa etapa futura.</p>
    </div>

    <section class="mb-8">
        <h2 class="text-2xl font-bold mb-2">Trajetória</h2>
        <p class="opacity-75">[placeholder: histórico de carreira]</p>
    </section>

    <section class="mb-8">
        <h2 class="text-2xl font-bold mb-2">Como trabalho</h2>
        <p class="opacity-75">[placeholder: processo e metodologia]</p>
    </section>

    <section class="mb-8">
        <h2 class="text-2xl font-bold mb-2">Ferramentas</h2>
        <p class="opacity-75">[placeholder: lista de ferramentas]</p>
    </section>
</BaseLayout>
