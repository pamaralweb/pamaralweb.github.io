---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SideBar from "../components/SideBar.astro";

import { SITE_TITLE, SITE_DESCRIPTION } from "../config";

const { image, title = SITE_TITLE, description = SITE_DESCRIPTION, includeSidebar = true, sideBarActiveItemID } = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body class="bg-canvas text-ink">
    <div class="lg:flex">
      <input id="nav-toggle" type="checkbox" class="peer hidden" />
      <label
        for="nav-toggle"
        class="fixed inset-0 z-30 hidden bg-ink/40 peer-checked:block lg:hidden"
        aria-hidden="true"
      ></label>
      {includeSidebar && <SideBar sideBarActiveItemID={sideBarActiveItemID} />}
      <div class="flex min-h-screen flex-1 flex-col">
        <Header title={SITE_TITLE} includeSidebar={includeSidebar} />
        <main class="mx-auto w-full max-w-[880px] flex-1 px-6 py-10 lg:px-14 lg:py-16">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
  </body>
</html>
