---
const { includeSidebar = true } = Astro.props;
---

<div
  class="sticky top-0 z-20 flex h-16 w-full items-center justify-between border-b border-line bg-canvas/90 px-6 backdrop-blur lg:hidden"
>
  {
    includeSidebar ? (
      <label for="nav-toggle" class="flex h-9 w-9 items-center justify-center rounded-lg hover:bg-surface" aria-label="Abrir menu">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="h-5 w-5 stroke-ink">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </label>
    ) : (
      <span />
    )
  }
  <a class="font-display text-base font-semibold" href="/">Patrick Amaral</a>
  <span></span>
</div>
