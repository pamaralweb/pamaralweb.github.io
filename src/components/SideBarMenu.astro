---
const { sideBarActiveItemID } = Astro.props;
---

<nav class="flex-1 overflow-y-auto px-4 py-2">
    <ul class="flex flex-col gap-1 text-sm">
        <li><a class="block rounded-lg px-3 py-2.5 text-muted transition-colors hover:bg-surface hover:text-ink" id="home" href="/">Início</a></li>
        <li><a class="block rounded-lg px-3 py-2.5 text-muted transition-colors hover:bg-surface hover:text-ink" id="trabalhos" href="/trabalhos/">Trabalhos</a></li>
        <li><a class="block rounded-lg px-3 py-2.5 text-muted transition-colors hover:bg-surface hover:text-ink" id="sobre" href="/sobre/">Sobre</a></li>
        <li><a class="block rounded-lg px-3 py-2.5 text-muted transition-colors hover:bg-surface hover:text-ink" href="/cv-patrick-amaral.pdf" target="_blank">Currículo</a></li>
        <!-- Blog fora do menu por enquanto: rota /blog/ segue funcionando, sem link visível até ter ritmo de publicação -->
    </ul>
</nav>

<script define:vars={{ sideBarActiveItemID }}>
const activeItemElem = document.getElementById(sideBarActiveItemID);
if (activeItemElem) {
    activeItemElem.classList.remove("text-muted");
    activeItemElem.classList.add("bg-surface", "text-ink", "font-medium");
}
</script>
