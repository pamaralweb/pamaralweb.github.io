---
interface Props {
    src: string;
    alt: string;
    caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="my-6">
    <img src={src} alt={alt} loading="lazy" class="w-full rounded-lg" />
    {caption && <figcaption class="text-sm opacity-75 mt-2 text-center">{caption}</figcaption>}
</figure>
