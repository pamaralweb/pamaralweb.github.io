---
interface Props {
    variant?: "info" | "warning" | "note";
    title?: string;
}

const { variant = "note", title } = Astro.props;

const styles: Record<string, string> = {
    info: "border-accent/40 bg-accent/5",
    warning: "border-warning/50 bg-warning-surface",
    note: "border-line bg-surface",
};
---

<div class={`flex flex-col items-start gap-1 rounded-xl border p-4 my-6 not-prose ${styles[variant]}`} role="note">
    {title && <p class="font-display font-semibold text-sm">{title}</p>}
    <div class="text-sm text-ink/90 leading-relaxed">
        <slot />
    </div>
</div>
