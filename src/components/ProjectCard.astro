---
interface Props {
    title?: string;
    img?: string;
    imgAlt?: string;
    url: string;
    tags?: string[];
}

const { title, img, imgAlt, url, tags } = Astro.props;
---

<a href={url} class="card flex h-full flex-col overflow-hidden transition-shadow hover:shadow-md">
    {
        img && (
            <img
                src={img}
                width={960}
                height={540}
                alt={imgAlt ?? ""}
                class="aspect-video w-full border-b border-line object-cover object-top"
                loading="lazy"
            />
        )
    }
    <div class="flex grow flex-col gap-2 p-4">
        <h3 class="font-display text-base font-semibold text-ink">{title}</h3>
        {
            tags && tags.length > 0 && (
                <div class="flex flex-wrap gap-2">
                    {tags.map((tag) => <span class="tag">{tag}</span>)}
                </div>
            )
        }
    </div>
</a>
