---
const { title, img, desc, url, badge, tags, target = "_blank" } = Astro.props;
---

<div class="card transition-shadow hover:shadow-md">
  <a href={url} target={target} class="flex flex-col gap-4 p-4 md:flex-row">
    {
      img && (
        <img
          src={img}
          width={750}
          height={422}
          alt={title}
          class="aspect-video w-full rounded-lg object-cover md:w-52 md:flex-shrink-0"
          loading="lazy"
        />
      )
    }
    <div class="flex min-w-0 grow flex-col justify-center gap-2">
      <h3 class="font-display text-lg font-semibold text-ink">
        {title}
        {badge && <span class="tag tag-accent ml-2 align-middle">{badge}</span>}
      </h3>
      {desc && <p class="text-sm text-muted">{desc}</p>}
      {
        tags && tags.length > 0 && (
          <div class="flex flex-wrap gap-2 pt-1">
            {tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        )
      }
    </div>
  </a>
</div>
