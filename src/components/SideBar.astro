---
import SideBarFooter from "./SideBarFooter.astro";
import SideBarMenu from "./SideBarMenu.astro";
const { sideBarActiveItemID } = Astro.props;
---

<aside
  class="fixed inset-y-0 left-0 z-40 flex w-[260px] -translate-x-full flex-col border-r border-line bg-canvas transition-transform duration-200 peer-checked:translate-x-0 lg:sticky lg:top-0 lg:h-screen lg:translate-x-0"
>
  <a href="/" class="flex items-center gap-3 px-6 py-8">
    <img
      src="/profile.jpg"
      alt="Foto de perfil de Patrick Amaral"
      width="44"
      height="44"
      class="h-11 w-11 rounded-xl object-cover"
    />
    <span class="font-display text-base font-semibold">Patrick Amaral</span>
  </a>
  <SideBarMenu sideBarActiveItemID={sideBarActiveItemID} />
  <SideBarFooter />
</aside>
